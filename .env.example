# =================================================================
# dbmaps Environment Configuration
# =================================================================

# Node Environment & Port Configuration
NODE_ENV=production
PORT=3000

# Server / Public App URL (Used for CORS, webhook callback links, redirects)
APP_URL=https://your-domain.com

# Gemini AI API Key (Server-side only)
# Required for AI-powered schema generation & DBML/SQL conversions
GEMINI_API_KEY=

# Gemini Model Selection (e.g. gemini-3.8-flash, gemini-3.1-pro-preview, gemini-3.1-flash-lite)
# Default is gemini-3.8-flash. Can also be changed in Admin Control Center.
GEMINI_MODEL=gemini-3.8-flash

# Root Administrator Email (Has full superadmin access to tier control, user credit overrides, and system settings)
ADMIN_EMAIL=aungkyawminn.aya@gmail.com

# TallySale Payment Gateway Credentials:
# Required for automated Pro tier subscription invoicing and payment webhooks
TALLYSALE_API_KEY=
TALLYSALE_API_SECRET=
TALLYSALE_PAYMENT_URL=https://api.tallysale.com
TALLYSALE_PORTAL_URL=https://tallysale.com

# Optional: Firebase API Key fallback (if not loaded from firebase-applet-config.json)
FIREBASE_API_KEY=

# Feature Flags:
# VITE_ENABLE_UPGRADE_CREDITS: Show or hide Upgrade & AI Credits UI buttons (default: true)
VITE_ENABLE_UPGRADE_CREDITS=true

# Google Analytics Measurement ID
VITE_GA_MEASUREMENT_ID=G-31PW33MP6B


