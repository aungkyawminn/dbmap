// DBML Database Schema: Event Ticketing Platform
// Generated on 9/23/2026

Table roles [headercolor: #3b82f6] {
  id bigint [pk, increment]
  name varchar(255)
  description text
  created_at timestamp
  updated_at timestamp
  created_by bigint [ref: >? users.id]
  updated_by bigint [ref: >? users.id]
}

Table abilities [headercolor: #10b981] {
  id bigint [pk, increment]
  action varchar(255) [note: 'Example: read, write, delete']
  subject varchar(255) [note: 'Application resource/model name, e.g. User, Role, Ability, Event']
  created_at timestamp
  created_by bigint [ref: >? users.id]
}

Table role_abilities [headercolor: #8b5cf6] {
  id bigint [pk, increment]
  role_id bigint [ref: > roles.id]
  ability_id bigint [ref: > abilities.id]
  created_at timestamp
  created_by bigint [ref: >? users.id]
}

Table personal_access_tokens [headercolor: #f59e0b] {
  id bigint [pk, increment]
  tokenable_type varchar(255)
  tokenable_id bigint
  name varchar(255)
  token varchar(64)
  abilities text
  last_used_at timestamp
  expires_at timestamp
  created_at timestamp
  updated_at timestamp

  Note: '''
    **Admin Portal** - *Increment*  
    This table is used by laravel sanctum 
    token authentication that is implemented in
    admin portal.
  '''
}

Table tokens [headercolor: #79AD51] {
  id bigint [increment, note: 'for indexing, performance purpose when data become bigger']
  token text [not null]
  action token_action_enum
  authenticable_id bigint [note: '''
    Relationship to customers table currently.
    This field is intended for secure actions from public link sent via email
  ''']
  authenticable_type varchar(255) [note: 'Model, currently Customer']
  is_completed boolean [note: '''
    '
        token becomes invalid after user click and took the action, is_completed is true
  ''']
  created_at timestamp
  expired_at timestamp [note: 'token becomes invalid if it is expired']
  updated_at timestamp

  Note: '''
    **Customer Portal** - *Increment*  
    One time use tokens for authentication
    This table is used for temporary authentication of following actions
    1. customer account activation
    2. customer password reset
    from external public link embedded in email.
    token is created when action is started.
    token is deleted when user takes action on link.
    - for security, token is needed to bind with action id (customer_id)
    and it is passed on public url
  '''
}

Table upload_files [headercolor: #06b6d4] {
  id bigint [increment]
  file_url text [note: 'full path of file']
  is_completed boolean [note: '''
    file uploaded, generated url is_completed is 0
    when generated url is saved in database and actually applied, is_completed is 1
  ''']

  Note: '**Admin Portal** - *Increment*'
}

Table users [headercolor: #6366f1] {
  id bigint [pk, note: 'Snowflake ID']
  username varchar(255)
  password varchar(255)
  role_id bigint [ref: > roles.id]
  email varchar(255) [unique]
  title varchar(255)
  full_name varchar(255)
  country_code varchar(255)
  mobile_number varchar(255)
  avatar varchar(255)
  status user_statuses
  created_at timestamp
  updated_at timestamp
  created_by bigint
  updated_by bigint

  Note: '''
    **Admin Portal** - *Snowflake ID*  
    Authentication table for admin portal
    There may be different 
    kind of admin roles.
  '''
}

Table organizers [headercolor: #3b82f6] {
  id bigint [pk, note: 'Snowflake ID']
  name varchar(255)
  description text
  email varchar(255) [unique]
  company_legal_name varchar(255)
  position varchar(255)
  company_phone varchar(255)
  tax_payer_no varchar(255)
  website varchar(255)
  avatar varchar(255) [note: 'this is profile picture url']
  created_at timestamp
  updated_at timestamp
  created_by bigint
  updated_by bigint

  Note: '''
    **Admin Portal** - *Snowflake ID*
    This is organizer profile table
    for information display attached to Event.
    Later on will be linked to organizer_users auth table
    when organizer portal is developed
  '''
}

Table types [headercolor: #10b981] {
  id bigint [pk, increment]
  name varchar(255)
  created_at timestamp
  updated_at timestamp
  created_by bigint
  updated_by bigint

  Note: '**Admin Portal** - *Increment*'
}

Table categories [headercolor: #8b5cf6] {
  id bigint [pk, increment]
  name varchar(255)
  created_at timestamp
  updated_at timestamp
  created_by bigint
  updated_by bigint

  Note: '**Admin Portal** - *Increment*'
}

Table tags [headercolor: #f59e0b] {
  id bigint [pk, increment]
  name varchar(255)
  created_at timestamp
  updated_at timestamp
  updated_by bigint
  created_by bigint

  Note: '**Admin Portal** - *Increment*'
}

Table customers [headercolor: #79AD51] {
  id bigint [pk, note: 'Snowflake ID']
  username varchar [unique]
  password varchar
  email varchar [unique]
  title varchar(255)
  full_name varchar(255)
  country_code varchar
  mobile_number varchar
  avatar varchar(255)
  status user_statuses
  type customer_type_enum
  created_at timestamp
  updated_at timestamp
  created_by bigint
  updated_by bigint

  Note: '**Customer Portal** - *Snowflake ID* When a user register, add to this table as customer. Use this table for authentication of customers.'
}

Table customer_sso_logins [headercolor: #79AD51] {
  id bigint [pk, increment]
  customer_id bigint
  sso_login_provider_id varchar(255)
  sso_login_provider_name varchar(255) [note: 'google, facebook']
  login_provider_access_token text
  login_provider_refresh_token text
  login_provider_expires_in datetime

  Note: '''
    **Customer Portal** - *Increment*  
    When a user register using sso, add to this table to store SSO Provider information.
  '''
}

Table events [headercolor: #4B82B0] {
  id bigint [pk, note: 'Snowflake ID']
  title varchar(255)
  organizer_id bigint [ref: > organizers.id]
  organizer_name varchar(255)
  event_template event_templates [note: '''
    Default is always used in Primary Website
    The left templates (Template-1 and Template-2) 
    will be used in custom domain binding
  ''']
  type_id bigint [ref: > types.id]
  type_name varchar(255)
  category_id bigint [ref: > categories.id]
  category_name varchar(255)
  slug varchar(255) [unique, note: 'url slug name of the event using kebab-case string']
  alternative_domain varchar(255) [unique, note: '''
    to bind with event url and domain for
    premium organizer
  ''']
  tags json [note: 'array of tag_name e.g ["art", "tech", "science"]']
  about longtext
  location_type location_types
  venue_address text
  online_address text
  map_url text
  start_date date
  end_date date
  start_time time [note: 'time format is HH:MM:SS']
  end_time time
  banner_images json [note: 'array of image url or name']
  agenda json [note: '''
    ```json
    [ 
      { 
        "name": "Day 1",
        "slots": [ 
          { 
            "title": "title 1", 
            "start_at": "1:00PM", 
            "end_at": "3:00PM", 
            "performers": [ 
              { 
                "name": "U Nyo", 
                "image": "file.png"
              }, 
              { 
                "name": "Daw Pu", 
                "image": "file1.png"
              } 
            ], 
            "description": "xxxxxxx",
            "order": "1"
          }, 
          { 
            "title": "title 1.1", 
            "start_at": "4:00PM", 
            "end_at": "6:00PM", 
            "performers": [ 
              { 
                "name": "U Nyo", 
                "image": "file.png"
              }, 
              { 
                "name": "Daw Pu", 
                "image": "file1.png"
              } 
            ], 
            "description": "xxxxxxx",
            "order": "1"
          },
        ],
        "order": "1"
      }, 
      { 
        "name": "Day 2", 
        "slots": [ 
          { 
            "title": "title 2", 
            "start_at": "1:00PM", 
            "end_at": "3:00PM", 
            "performers": [ 
              { 
                "name": "U Mg", 
                "image": "file.png"
              }, 
              { 
                "name": "Daw Saung", 
                "image": "file1.png"
              } 
            ], 
            "description": "xxxxxxx",
            "order": "1"
          } 
        ],
        "order": "1"
      } 
    ] 
    ```
  ''']
  faqs json [note: '''
    [
      {
        "question": "bla bla bla",
        "answer": "bra bra bra",
        "order": "1"
      },
      {
        "question": "bla bla bla",
        "answer": "bra bra bra",
        "order": "2"
      }
    ]
  ''']
  additional_information longtext
  event_images json [note: 'array of image_url or name']
  sponsors json [note: '''
    [
      {
        "tier": "silver",
        "images": [
          {
            "name": "name",
            "url": "s3_url",
            "order": "1"
          },
          {
            "name": "name",
            "url": "s3_url",
            "order": "2"
          }
        ],
        "order": "1"
      },
      {
        "tier": "silver",
        "images": [
          {
            "name": "name",
            "url": "s3_url",
            "order": "1"
          },
          {
            "name": "name",
            "url": "s3_url",
            "order": "2"
          }
        ],
        "order": "1"
      },
      {
        "tier": "silver",
        "images": [
          {
            "name": "name",
            "url": "s3_url",
            "order": "1"
          },
          {
            "name": "name",
            "url": "s3_url",
            "order": "2"
          }
        ],
        "order": "1"
      }
    ]
  ''']
  contact_infomation json [note: '''
    this contact information is displayed in 
    footer of Event Templates. it is aimed for specific 
    event contact rather than organizer contact
    json
    ```
    {
      "phone_number": "09xxxx",
      "email": "hello@onenex.co"
    }
    ```
  ''']
  social_links json [note: '''
    {
      "facebook_url": "https://fb.com/xxxx",
      "instagram_url": "https://instagram.com/xxxx",
      "twitter_url": "https://x.com/xxxx",
      "linkedin_url": "https://linkedin.com/xxxx"
    }
  ''']
  settlement_status settlement_statuses
  event_status event_statuses
  visibility event_visibilities
  is_attendee_info_mandatory boolean
  publish_at timestamp
  end_at timestamp
  created_at timestamp
  updated_at timestamp
  created_by bigint
  updated_by bigint

  Note: '**Admin Portal** - *Snowflake ID*'
}

Table event_tickets [headercolor: #3b82f6] {
  id bigint [pk, note: 'Snowflake ID']
  name varchar(255)
  entry_date date
  price decimal
  currency varchar(3)
  event_id int [ref: > events.id]
  ticket_type ticket_types
  initial_quantity int [note: 'Available Quantity initially enetered']
  remaining_quantity int [note: 'Available Quantity on live, update (decrease) this field after purchase success']
  sale_start_at timestamp [note: 'Normal Sale start time']
  sale_end_at timestamp [note: 'Normal sale end time']
  description text
  early_price decimal
  early_start_at timestamp [note: 'Early bird sale start time, before normal sale start time']
  early_end_at timestamp [note: 'Early bird sale end time, normal sale will start after that']
  ticket_visibility ticket_visibilities
  created_at timestamp
  updated_at timestamp
  created_by bigint
  updated_by bigint

  Note: '''
    **Admin Portal** - *Snowflake ID*  
    This table also serves as inventory for tickets
    When a ticket is purchased by customer,
    need to reduce remaining_quantity
  '''
}

Table customer_favorite_events [headercolor: #79AD51] {
  id bigint [pk, increment]
  customer_id bigint [ref: > customers.id]
  customer_name varchar(255)
  event_id bigint [ref: > events.id]
  created_at timestamp

  Note: '**Customer Portal** - *Increment*'
}

Table checkouts [headercolor: #79AD51] {
  id bigint [pk, note: 'Snowflake ID']
  customer_id bigint [ref: > customers.id]
  customer_email varchar(255)
  customer_name varchar(255) [note: 'customers.full_name']
  status checkout_status_enum
  created_at timestamp
  expired_at timestamp
  updated_at timestamp
  created_by bigint
  updated_by bigint

  Note: '**Customer Portal** - *Snowflake ID*'
}

Table checkout_tickets [headercolor: #79AD51] {
  id bigint [pk, note: 'Snowflake ID']
  checkout_id bigint [ref: > checkouts.id]
  event_ticket_id bigint
  event_ticket_name varchar(255)
  checking_out_quantity int
  price decimal(10, 2)
  currency varchar(3)
  created_at timestamp
  created_by bigint

  Note: '**Customer Portal** - *Snowflake ID*'
}

Table settings [headercolor: #ec4899] {
  id bigint
  key varchar(255) [note: 'payment_fee_rules']
  value jsonb [note: '''
    {
      "payment_fees": {
        "AYAPAY": {
          "percent": 0,
          "fixed": 0
        },
        "MMQR": {
          "percent": 0.005,
          "fixed": 0
        },
        "VISA": {
          "percent": 0.029,
          "fixed": 300
        }
      }
    }
  ''']
  updated_at timestamp
}

Table platform_fee_rules [headercolor: #06b6d4] {
  id bigint [pk]
  organizer_id bigint
  event_id bigint
  fee_type varchar(255)
  fee_value decimal(10, 2)
  currency varchar(3)
  effective_from timestamp
  effective_to timestamp
  is_active bool
  created_at timestamp
}

Table purchases [headercolor: #79AD51] {
  id bigint [pk, note: 'Snowflake ID']
  checkout_id bigint [ref: > checkouts.id]
  customer_id bigint [ref: > customers.id]
  customer_name varchar(255) [note: 'customers.full_name']
  event_id bigint [ref: > events.id]
  event_title varchar(255)
  total_amount decimal(10,2)
  currency varchar(3)
  status purchase_status_enum
  customer_type customer_type_enum
  created_at timestamp
  updated_at timestamp
  created_by bigint
  updated_by bigint

  Note: '**Customer Portal** - *Snowflake ID*'
}

Table purchase_tickets [headercolor: #79AD51] {
  id bigint [pk, note: 'Snowflake ID']
  purchase_id bigint [ref: > purchases.id]
  customer_id bigint [ref: > customers.id]
  customer_name varchar(255)
  event_id bigint [ref: > events.id]
  event_title varchar(255)
  event_ticket_id bigint [ref: > event_tickets.id]
  event_ticket_name varchar(255)
  price decimal(10, 2)
  currency varchar(3)
  platform_fee decimal(10, 2) [note: 'eventickat platform fee']
  payment_fee decimal(10, 2) [note: 'payment processing fee for payment gateway']
  tax_amount decimal(10, 2)
  net_amount decimal(10, 2)
  payout_amount decimal(10, 2) [note: 'share to organizer']
  ticket_number varchar [note: '''
    to generate unique combination for each ticket
    this number will be used for QR
  ''']
  attendee_name varchar
  attendee_email varchar
  attendee_phone varchar
  is_checked_in bool
  checked_in_at timestamp
  check_in_method varchar(255)
  check_in_location varchar(255)
  check_in_notes text
  created_at timestamp
  updated_at timestamp
  created_by bigint
  updated_by bigint

  Note: '''
    **Customer Portal** - *Snowflake ID*  
    This table represents each tickets sold with its own
    unique ticket number bind with attendee information.
  '''
}

Table settlements [headercolor: #79AD51] {
  id bigint [pk, note: 'Snowflake ID']
  event_id bigint
  event_title varchar(255)
  organizer_id bigint
  organizer_name varchar(255)
  total_gross_amount decimal(10, 2)
  total_platform_fee decimal(10, 2)
  total_payment_fee decimal(10, 2)
  total_tax_amount decimal(10, 2)
  total_net_amount decimal(10, 2)
  total_payout_amount decimal(10, 2)
  currency varchar(3) [note: 'ISO 4217 three-letter alphabetic code']
  settlement_status varchar(255)
  settlement_version int [increment, note: 'increment only if reversal + re-settlement happens']
  settled_at timestamp
  created_at timestamp
  updated_at timestamp
  created_by bigint
  updated_by bigint

  Note: '''
    **Customer Portal** - *Snowflake ID*  
    This table represents settlement transactions done by admin panel
  '''
}

Table settlement_purchase_tickets [headercolor: #79AD51] {
  id bigint [pk, note: 'Snowflake ID']
  settlement_id bigint [ref: > settlements.id]
  purchase_tickets_id bigint [ref: > purchase_tickets.id]
  gross_amount decimal(10, 2) [note: 'price value of related item in purchase_tickets']
  platform_fee decimal(10, 2) [note: 'eventickat platform fee']
  payment_fee decimal(10, 2) [note: 'payment processing fee for payment gateway']
  tax_amount decimal(10, 2)
  net_amount decimal(10, 2)
  payout_amount decimal(10, 2) [note: 'share to organizer']
  currency varchar(3) [note: 'ISO 4217 three-letter alphabetic code']
  created_at timestamp
  created_by bigint

  Note: 'This table represents settlement transactions of each sold tickets done by admin panel'
}

Table payments [headercolor: #79AD51] {
  id int [pk, note: 'Snowflake ID']
  payable_id bigint [ref: > purchases.id]
  payable_type varchar [note: 'Class name for payment']
  amount decimal(10, 2)
  payment_date datetime
  payment_status payment_statuses
  payment_method payment_methods
  transaction_id varchar(255) [note: 'transaction id responded from payment gateway']
  created_at timestamp
  updated_at timestamp
  created_by bigint
  updated_by bigint

  Note: '**Customer Portal** - *Snowflake ID*'
}
