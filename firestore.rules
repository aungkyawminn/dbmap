rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(ownerUid) {
      return isSignedIn() && request.auth.uid == ownerUid;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'aungkyawminn.aya@gmail.com' ||
        (request.auth.token.keys().hasAny(['admin']) && request.auth.token.admin == true)
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidProject(data) {
      return data.keys().hasAll(['id', 'name', 'tables', 'ownerUid'])
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.tables is list && data.tables.size() <= 500
        && data.ownerUid is string && data.ownerUid.size() <= 128;
    }

    function isValidDictionary(data) {
      return data.keys().hasAll(['title', 'tables', 'publishedAt'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.tables is list && data.tables.size() <= 500;
    }

    function canAccessProject(projectData) {
      return !('accessMode' in projectData) ||
             projectData.accessMode == 'public' ||
             projectData.accessMode == 'password' ||
             (isSignedIn() && (
               request.auth.uid == projectData.ownerUid ||
               request.auth.token.email == projectData.ownerEmail ||
               ('allowedEmails' in projectData && projectData.allowedEmails is list && projectData.allowedEmails.hasAny([request.auth.token.email])) ||
               isAdmin()
             ));
    }

    function canModifyProject(projectData) {
      return !('accessMode' in projectData) ||
             projectData.accessMode == 'public' ||
             projectData.accessMode == 'password' ||
             (isSignedIn() && (
               request.auth.uid == projectData.ownerUid ||
               request.auth.token.email == projectData.ownerEmail ||
               ('allowedEmails' in projectData && projectData.allowedEmails is list && projectData.allowedEmails.hasAny([request.auth.token.email])) ||
               isAdmin()
             ));
    }

    // Projects Collection
    match /projects/{projectId} {
      allow get, list: if true;
      allow create, update: if true;
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.ownerUid || isAdmin());
    }

    // Published Dictionaries Collection
    match /published_dictionaries/{dictionaryId} {
      allow get, list: if true;
      allow create: if true;
      allow update: if isSignedIn() && (isAdmin() || request.auth.uid == resource.data.authorUid || request.auth.token.email == resource.data.authorEmail);
      allow delete: if isSignedIn() && (isAdmin() || request.auth.uid == resource.data.authorUid || request.auth.token.email == resource.data.authorEmail);
    }

    // Marketplace Database Templates & Community Submissions
    match /marketplace_templates/{templateId} {
      allow get, list: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isSignedIn() && (isAdmin() || request.auth.uid == resource.data.authorUid || request.auth.token.email == resource.data.authorEmail);
    }

    // Users Collection (Profile, Tier & Credit Balance)
    // Managed via Express server API with server-side token verification
    match /users/{userId} {
      allow read, write: if true;
    }

    // Payment Requests Collection (TallySale invoices submitted for upgrade)
    match /payment_requests/{requestId} {
      allow read, write: if true;
    }

    // Usage Logs Collection
    match /usage_logs/{logId} {
      allow read, write: if true;
    }

    // System Configuration
    match /system/{configId} {
      allow read, write: if true;
    }

    // Live Rooms & Presence Subcollection
    match /rooms/{roomId} {
      allow get, list: if true;
      allow write: if true;
      match /presence/{sessionId} {
        allow get, list, write, delete: if true;
      }
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

