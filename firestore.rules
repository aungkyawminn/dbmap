rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(ownerUid) {
      return isSignedIn() && request.auth.uid == ownerUid;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'aungkyawminn.aya@gmail.com' ||
        (request.auth.token.keys().hasAny(['admin']) && request.auth.token.admin == true)
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidProject(data) {
      return data.keys().hasAll(['id', 'name', 'tables', 'ownerUid'])
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.tables is list && data.tables.size() <= 500
        && data.ownerUid is string && data.ownerUid.size() <= 128;
    }

    function isValidDictionary(data) {
      return data.keys().hasAll(['title', 'tables', 'publishedAt'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.tables is list && data.tables.size() <= 500;
    }

    function isProjectOwner(projectData) {
      return isSignedIn() && (
        request.auth.uid == projectData.ownerUid ||
        request.auth.token.email == projectData.ownerEmail ||
        isAdmin()
      );
    }

    function isProjectCollaborator(projectData) {
      return isSignedIn() && (
        'allowedEmails' in projectData &&
        projectData.allowedEmails is list &&
        projectData.allowedEmails.hasAny([request.auth.token.email])
      );
    }

    function canAccessProject(projectData) {
      return !('accessMode' in projectData) ||
             projectData.accessMode == 'public' ||
             projectData.accessMode == 'password' ||
             isProjectOwner(projectData) ||
             isProjectCollaborator(projectData);
    }

    function canModifyProject(projectData) {
      return isProjectOwner(projectData) ||
             (canAccessProject(projectData) &&
              request.resource.data.ownerUid == projectData.ownerUid &&
              request.resource.data.ownerEmail == projectData.ownerEmail &&
              request.resource.data.accessMode == projectData.accessMode &&
              request.resource.data.sharePassword == projectData.sharePassword &&
              request.resource.data.allowedEmails == projectData.allowedEmails);
    }

    // Projects Collection (Strict User Database Isolation & Granular Sharing)
    match /projects/{projectId} {
      // Direct access allowed if public, password-protected, owner, or whitelisted collaborator
      allow get: if canAccessProject(resource.data);

      // Scoped listing: only own projects, shared projects where whitelisted, or admin
      allow list: if isSignedIn() && (
        request.auth.uid == resource.data.ownerUid ||
        isProjectCollaborator(resource.data) ||
        isAdmin()
      );

      // Creation requires authenticated user creating their own project
      allow create: if isSignedIn() && (
        request.resource.data.ownerUid == request.auth.uid ||
        isAdmin()
      );

      // Update allowed by owner, admin, or invited collaborator without stealing ownership or altering permissions
      allow update: if canModifyProject(resource.data);

      // Delete allowed for project owner, admin, or guest/unassigned scratchpad project
      allow delete: if (isSignedIn() && (
        request.auth.uid == resource.data.ownerUid ||
        isAdmin()
      )) || resource.data.ownerUid == 'guest' || !('ownerUid' in resource.data);
    }

    // User Settings & Folders Collection
    match /user_settings/{userId} {
      allow read, write, delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Published Dictionaries Collection
    match /published_dictionaries/{dictionaryId} {
      allow get, list: if true;
      allow create: if isSignedIn() || isAdmin();
      allow update: if (
        isAdmin() ||
        (isSignedIn() && (request.auth.uid == resource.data.authorUid || request.auth.token.email == resource.data.authorEmail)) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']))
      );
      allow delete: if isSignedIn() && (
        isAdmin() ||
        request.auth.uid == resource.data.authorUid ||
        request.auth.token.email == resource.data.authorEmail
      );
    }

    // Marketplace Database Templates & Community Submissions
    match /marketplace_templates/{templateId} {
      allow get, list: if true;
      allow create: if isSignedIn() || isAdmin();
      allow update: if (
        isAdmin() ||
        (isSignedIn() && (request.auth.uid == resource.data.authorUid || request.auth.token.email == resource.data.authorEmail)) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clonesCount', 'updatedAt']))
      );
      allow delete: if isSignedIn() && (
        isAdmin() ||
        request.auth.uid == resource.data.authorUid ||
        request.auth.token.email == resource.data.authorEmail
      );
    }

    // Users Collection (Profile, Tier & Credit Balance)
    // Server API handles auth-verified requests; browser direct access scoped to caller
    match /users/{userId} {
      allow read: if !isSignedIn() || request.auth.uid == userId || isAdmin();
      allow write: if !isSignedIn() || isAdmin();
    }

    // Payment Requests Collection (TallySale invoices submitted for upgrade)
    match /payment_requests/{requestId} {
      allow read: if !isSignedIn() || (isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin()));
      allow write: if !isSignedIn() || (isSignedIn() && (request.auth.uid == request.resource.data.userId || isAdmin()));
    }

    // Usage Logs Collection
    match /usage_logs/{logId} {
      allow read: if !isSignedIn() || (isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin()));
      allow write: if !isSignedIn() || isAdmin();
    }

    // System Configuration
    match /system/{configId} {
      allow read: if true;
      allow write: if !isSignedIn() || isAdmin();
    }

    // Live Rooms & Presence Subcollection
    match /rooms/{roomId} {
      allow get, list: if true;
      allow write: if true;
      match /presence/{sessionId} {
        allow get, list, write, delete: if true;
      }
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

