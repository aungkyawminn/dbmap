{
  "entities": {
    "projects": {
      "title": "Projects",
      "description": "Database schema projects synced to Firestore",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "dialect": { "type": "string" },
        "tables": { "type": "array" },
        "relationships": { "type": "array" },
        "history": { "type": "array" },
        "folderId": { "type": "string" },
        "ownerUid": { "type": "string" },
        "ownerEmail": { "type": "string" },
        "accessMode": { "type": "string", "enum": ["public", "restricted", "password"] },
        "allowedEmails": { "type": "array", "items": { "type": "string" } },
        "sharePassword": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "tables", "ownerUid"]
    },
    "published_dictionaries": {
      "title": "Published Dictionaries",
      "description": "Public read-only database documentation dictionaries",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "dialect": { "type": "string" },
        "tables": { "type": "array" },
        "relationships": { "type": "array" },
        "publishedBy": { "type": "string" },
        "publishedAt": { "type": "string" },
        "isPasswordProtected": { "type": "boolean" },
        "password": { "type": "string" },
        "views": { "type": "number" }
      },
      "required": ["title", "tables", "publishedAt"]
    },
    "users": {
      "title": "User Profiles & Tier Credits",
      "description": "Stores user tier ('free'/'pro'), remaining AI credits, and usage stats",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "tier": { "type": "string" },
        "role": { "type": "string" },
        "creditsRemaining": { "type": "number" },
        "monthlyCreditAllowance": { "type": "number" },
        "creditsUsedTotal": { "type": "number" },
        "lastResetDate": { "type": "string" },
        "hasCompletedTour": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email", "tier", "creditsRemaining"]
    },
    "payment_requests": {
      "title": "TallySale Payment Requests",
      "description": "Submitted TallySale invoice numbers and payment proofs for tier upgrade verification",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "invoiceRef": { "type": "string" },
        "requestedTier": { "type": "string" },
        "amountPaid": { "type": "number" },
        "status": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" },
        "reviewedAt": { "type": "string" }
      },
      "required": ["id", "userId", "invoiceRef", "status"]
    },
    "usage_logs": {
      "title": "AI Token Usage Logs",
      "description": "Logs of token consumption per Gemini AI schema generation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "tier": { "type": "string" },
        "promptLength": { "type": "number" },
        "promptTokens": { "type": "number" },
        "completionTokens": { "type": "number" },
        "totalTokens": { "type": "number" },
        "dialect": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "userId", "totalTokens", "timestamp"]
    },
    "system_config": {
      "title": "System Tier Configurations",
      "description": "Configurable tier token allowances and TallySale URL settings",
      "type": "object",
      "properties": {
        "freeTierMonthlyCredits": { "type": "number" },
        "proTierMonthlyCredits": { "type": "number" },
        "freeMaxPromptLength": { "type": "number" },
        "proMaxPromptLength": { "type": "number" },
        "tallySaleInvoiceUrl": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "marketplace_templates": {
      "title": "Marketplace Database Templates",
      "description": "Curated system blueprints and community-submitted database schemas",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "complexity": { "type": "string" },
        "dialect": { "type": "string" },
        "tables": { "type": "array" },
        "relationships": { "type": "array" },
        "highlights": { "type": "array" },
        "authorUid": { "type": "string" },
        "authorEmail": { "type": "string" },
        "authorName": { "type": "string" },
        "isSystem": { "type": "boolean" },
        "clonesCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "tables", "category"]
    },
    "issues": {
      "title": "Issue Reports & Feature Submissions",
      "description": "User reported defects, bug reports, and enhancement proposals",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "severity": { "type": "string" },
        "status": { "type": "string" },
        "component": { "type": "string" },
        "description": { "type": "string" },
        "reproductionSteps": { "type": "string" },
        "expectedBehavior": { "type": "string" },
        "actualBehavior": { "type": "string" },
        "environment": { "type": "object" },
        "authorUid": { "type": "string" },
        "authorEmail": { "type": "string" },
        "authorName": { "type": "string" },
        "votes": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "category", "severity", "description", "authorUid", "authorEmail", "createdAt"]
    }
  },
  "firestore": {
    "/issues/{issueId}": {
      "schema": "issues",
      "description": "User reported bugs and feature requests"
    },
    "/marketplace_templates/{templateId}": {
      "schema": "marketplace_templates",
      "description": "Public database schemas submitted to the community marketplace"
    },
    "/projects/{projectId}": {
      "schema": "projects",
      "description": "Schema projects collection"
    },
    "/published_dictionaries/{dictionaryId}": {
      "schema": "published_dictionaries",
      "description": "Published read-only database dictionaries"
    },
    "/users/{userId}": {
      "schema": "users",
      "description": "User profile with tier and credit details"
    },
    "/payment_requests/{requestId}": {
      "schema": "payment_requests",
      "description": "TallySale payment proofs submitted for manual or auto tier upgrade approval"
    },
    "/usage_logs/{logId}": {
      "schema": "usage_logs",
      "description": "Audit trail of Gemini API token consumption"
    },
    "/system/config": {
      "schema": "system_config",
      "description": "Global system tier settings"
    }
  }
}
